<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Plantillas de la actividad de reposo (reloj). Mismo formato que las de cualquier módulo. -->

    <DataTemplate x:Key="clock.Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource IslandAccent}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource IslandForeground}"
                       FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="clock.Peek">
        <DockPanel Margin="18,0" VerticalAlignment="Center" LastChildFill="False">
            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{DynamicResource IslandAccent}"
                     VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock DockPanel.Dock="Left" Text="Nexus Island" Foreground="{DynamicResource IslandForeground}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{DynamicResource IslandForegroundMuted}"
                       FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="clock.Expanded">
        <Grid Margin="26,20,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource IslandAccent}" Margin="0,0,9,0" />
                <TextBlock Text="Nexus Island" Foreground="{DynamicResource IslandForegroundMuted}"
                           FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource IslandForeground}"
                           FontSize="44" FontWeight="Light" />
                <TextBlock Text="{Binding Date}" Foreground="{DynamicResource IslandForegroundMuted}"
                           FontSize="13" Margin="2,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{Binding Hint}" Foreground="{DynamicResource IslandForegroundMuted}"
                       FontSize="11" Opacity="0.8" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
