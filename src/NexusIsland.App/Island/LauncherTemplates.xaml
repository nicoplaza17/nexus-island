<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:NexusIsland.App.Properties">
    <!-- Panel de herramientas (se abre con el botón ⊞ de la isla expandida). -->

    <DataTemplate x:Key="launcher.Compact">
        <TextBlock Text="&#xE8A9;" FontFamily="{DynamicResource IslandGlyphFont}" FontSize="12"
                   Foreground="{DynamicResource IslandForegroundMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="launcher.Peek">
        <TextBlock Text="{x:Static loc:Strings.Tools}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource IslandForeground}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="launcher.Expanded">
        <Grid Margin="16,14,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static loc:Strings.Tools}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,8"
                       Foreground="{DynamicResource IslandForegroundMuted}" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Siempre 2 filas: las columnas se ajustan a la cantidad de herramientas
                             (7 → 4 columnas anchas; 9-10 → 5), así los nombres no se cortan ni sobra una fila. -->
                        <UniformGrid Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource IslandPillButton}" Margin="3" Padding="4,6"
                                Command="{Binding Command}" ToolTip="{Binding Label}"
                                AutomationProperties.Name="{Binding Label}">
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandGlyphFont}" FontSize="16"
                                           HorizontalAlignment="Center" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding Label}" FontSize="10.5" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
