<Window x:Class="NexusIsland.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NexusIsland.App.Properties"
        Title="{x:Static loc:Strings.Settings_Title}"
        Icon="pack://application:,,,/Assets/NexusIsland.ico"
        Width="560" Height="720" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="Warning" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0A030" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,8,24,24">

            <!-- ================================ GENERAL -->
            <TextBlock Text="{x:Static loc:Strings.Settings_General}" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="StartWithWindowsBox" Content="{x:Static loc:Strings.Settings_StartWithWindows}" />
            <TextBlock x:Name="StartupWarning" Style="{StaticResource Warning}" Visibility="Collapsed"
                       Text="{x:Static loc:Strings.Settings_StartupBlocked}" />
            <CheckBox x:Name="HideFullscreenBox" Content="{x:Static loc:Strings.Settings_HideFullscreen}" Margin="0,8,0,0" />

            <!-- ================================ IDIOMA -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Language}" Style="{StaticResource SectionTitle}" />
            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" MinWidth="240"
                      AutomationProperties.Name="{x:Static loc:Strings.Settings_Language}">
                <ComboBoxItem Tag="auto" Content="{x:Static loc:Strings.Settings_LanguageAuto}" />
                <ComboBoxItem Tag="es" Content="Español" />
                <ComboBoxItem Tag="en" Content="English" />
            </ComboBox>
            <StackPanel x:Name="LanguageRestartPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Warning}" VerticalAlignment="Center" Text="{x:Static loc:Strings.Settings_RestartNeeded}" />
                <Button x:Name="LanguageRestartButton" Content="{x:Static loc:Strings.Settings_RestartNow}" Margin="12,0,0,0" Padding="12,4" />
            </StackPanel>

            <!-- ================================ APARIENCIA -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Size}" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SizeSmall" GroupName="Size" Content="{x:Static loc:Strings.Settings_SizeSmall}" Margin="0,0,20,0" />
                <RadioButton x:Name="SizeNormal" GroupName="Size" Content="{x:Static loc:Strings.Settings_SizeNormal}" Margin="0,0,20,0" />
                <RadioButton x:Name="SizeLarge" GroupName="Size" Content="{x:Static loc:Strings.Settings_SizeLarge}" />
            </StackPanel>

            <!-- ================================ POSICIÓN -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Position}" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static loc:Strings.Settings_PositionHint}" />
            <StackPanel x:Name="MonitorList" Margin="0,4,0,0" />
            <TextBlock x:Name="FloatingInfo" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,6,0,0" />

            <!-- ================================ ATAJO -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Hotkey}" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal">
                <Border Padding="12,6" CornerRadius="6" BorderThickness="1" BorderBrush="#40808080" MinWidth="150">
                    <TextBlock x:Name="HotkeyText" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="ChangeHotkeyButton" Content="{x:Static loc:Strings.Settings_Change}" Margin="10,0,0,0" Padding="14,6" />
            </StackPanel>
            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />

            <!-- ================================ MÓDULOS -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Modules}" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="ModuleList" />
            <StackPanel x:Name="RestartPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Warning}" VerticalAlignment="Center" Text="{x:Static loc:Strings.Settings_RestartNeeded}" />
                <Button x:Name="RestartButton" Content="{x:Static loc:Strings.Settings_RestartNow}" Margin="12,0,0,0" Padding="12,4" />
            </StackPanel>

            <!-- ================================ MULTIMEDIA -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Media}" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="NotifyTrackBox" Content="{x:Static loc:Strings.Settings_NotifyTrack}" />
            <CheckBox x:Name="AnimatedBarsBox" Content="{x:Static loc:Strings.Settings_AnimatedBars}" Margin="0,6,0,0" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Strings.Settings_AnimatedBarsHint}" />
            <TextBlock Text="{x:Static loc:Strings.Settings_IgnoredApps}" FontWeight="SemiBold" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static loc:Strings.Settings_IgnoredHint}" />
            <StackPanel x:Name="AppList" Margin="0,4,0,0" />
            <TextBlock x:Name="NoAppsText" Style="{StaticResource Hint}" Visibility="Collapsed"
                       Text="{x:Static loc:Strings.Settings_NoApps}" />
            <Button x:Name="RefreshAppsButton" Content="{x:Static loc:Strings.Settings_Refresh}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />

            <!-- ================================ NOTIFICACIONES -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Notifications}" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="NotificationStatus" Style="{StaticResource Hint}" />
            <CheckBox x:Name="ShowContentBox" Content="{x:Static loc:Strings.Settings_ShowContent}" Margin="0,2" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static loc:Strings.Settings_ShowContentHint}" />
            <TextBlock Text="{x:Static loc:Strings.Settings_MutedApps}" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static loc:Strings.Settings_MutedHint}" />
            <StackPanel x:Name="MutedList" />
            <TextBlock x:Name="NoMutedText" Style="{StaticResource Hint}" Text="{x:Static loc:Strings.Settings_None}" />

            <!-- ================================ TAREAS EN SEGUNDO PLANO -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Tasks}" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static loc:Strings.Settings_TasksHint}" />
            <CheckBox x:Name="TaskDownloadsBox" Content="{x:Static loc:Strings.Settings_TaskDownloads}" Margin="0,2" />
            <CheckBox x:Name="TaskCopiesBox" Content="{x:Static loc:Strings.Settings_TaskCopies}" Margin="0,2" />
            <CheckBox x:Name="TaskInstallersBox" Content="{x:Static loc:Strings.Settings_TaskInstalls}" Margin="0,2" />

            <!-- ================================ MONITOREO -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Alerts}" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static loc:Strings.Settings_AlertsHint}" />
            <CheckBox x:Name="AlertCpuBox" Content="{x:Static loc:Strings.Settings_AlertCpu}" Margin="0,2" />
            <CheckBox x:Name="AlertMemoryBox" Content="{x:Static loc:Strings.Settings_AlertMemory}" Margin="0,2" />
            <CheckBox x:Name="AlertBatteryBox" Content="{x:Static loc:Strings.Settings_AlertBattery}" Margin="0,2" />
            <CheckBox x:Name="AlertNetworkBox" Content="{x:Static loc:Strings.Settings_AlertNetwork}" Margin="0,2" />

            <!-- ================================ TRADUCTOR -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Translator}" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Strings.Settings_TranslatorHint}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="TranslatorStatus" VerticalAlignment="Center" />
                <Button x:Name="DeleteModelsButton" Content="{x:Static loc:Strings.Settings_DeleteModels}" Margin="12,0,0,0" Padding="12,4" />
            </StackPanel>

            <!-- ================================ ACERCA DE -->
            <TextBlock Text="{x:Static loc:Strings.Settings_About}" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="OpenSettingsFolderButton" Content="{x:Static loc:Strings.Settings_OpenConfigFolder}" Padding="12,4" />
                <Button x:Name="OpenLogsButton" Content="{x:Static loc:Strings.Settings_OpenLogs}" Margin="10,0,0,0" Padding="12,4" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
