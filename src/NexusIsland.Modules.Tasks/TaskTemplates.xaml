<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:NexusIsland.Modules.Tasks.Properties">
    <!--
      tasks.*       → tareas en curso (RunningTasksViewModel)
      tasks.done.*  → aviso de tarea terminada (TaskDoneViewModel)
      Sin barras "indeterminadas" animadas: redibujarían la isla sin parar mientras dura una descarga.
    -->
    <FontFamily x:Key="TskGlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="TskAccent" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="TskOk" Color="#FF34D399" />
    <SolidColorBrush x:Key="TskFail" Color="#FFF87171" />
    <BooleanToVisibilityConverter x:Key="TskBoolToVisibility" />

    <ControlTemplate x:Key="TskBar" TargetType="ProgressBar">
        <Grid>
            <Border CornerRadius="2" Background="#33FFFFFF" />
            <Border x:Name="PART_Track" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                    Background="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- ============================================================ EN CURSO -->
    <DataTemplate x:Key="tasks.Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="12" Margin="0,1,8,0"
                       Foreground="{StaticResource TskAccent}" />
            <TextBlock Text="{Binding ShortText}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="tasks.Peek">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="13" Margin="0,1,10,0"
                       Foreground="{StaticResource TskAccent}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource IslandForeground}" />
                <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource IslandForegroundMuted}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding MoreText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource IslandForegroundMuted}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="tasks.Expanded">
        <Grid Margin="20,14,20,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static loc:Strings.Panel_Title}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource IslandForegroundMuted}" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="14"
                                       Margin="0,2,10,0" Foreground="{StaticResource TskAccent}" />
                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,90,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForeground}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource IslandForegroundMuted}" />
                                </Grid>
                                <ProgressBar Height="3" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                             Value="{Binding Progress, Mode=OneWay}" Template="{StaticResource TskBar}"
                                             Foreground="{StaticResource TskAccent}"
                                             Visibility="{Binding HasProgress, Converter={StaticResource TskBoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ TERMINADA -->
    <DataTemplate x:Key="tasks.done.Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
            <Grid Margin="0,1,8,0">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="12" Foreground="{StaticResource TskOk}"
                           Visibility="{Binding IsOk, Converter={StaticResource TskBoolToVisibility}}" />
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="12" Foreground="{StaticResource TskFail}"
                           Visibility="{Binding IsFailed, Converter={StaticResource TskBoolToVisibility}}" />
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" MaxWidth="110"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="tasks.done.Peek">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,1,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="13" Foreground="{StaticResource TskOk}"
                           Visibility="{Binding IsOk, Converter={StaticResource TskBoolToVisibility}}" />
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="13" Foreground="{StaticResource TskFail}"
                           Visibility="{Binding IsFailed, Converter={StaticResource TskBoolToVisibility}}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource IslandForeground}" />
                <TextBlock Text="{Binding Detail}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource IslandForegroundMuted}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="tasks.done.Expanded">
        <Grid Margin="24,16,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Grid Margin="0,2,10,0">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="16" Foreground="{StaticResource TskOk}"
                               Visibility="{Binding IsOk, Converter={StaticResource TskBoolToVisibility}}" />
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource TskGlyphFont}" FontSize="16" Foreground="{StaticResource TskFail}"
                               Visibility="{Binding IsFailed, Converter={StaticResource TskBoolToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource IslandForeground}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Detail}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="36"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForegroundMuted}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <Button Style="{DynamicResource IslandPillButton}" Command="{Binding ShowInFolderCommand}" Content="{x:Static loc:Strings.Show_InFolder}"
                        AutomationProperties.Name="{x:Static loc:Strings.Show_InFolderA11y}" Margin="0,0,6,0"
                        Visibility="{Binding CanShowInFolder, Converter={StaticResource TskBoolToVisibility}}" />
                <Button Style="{DynamicResource IslandPillButton}" Command="{Binding CloseCommand}" Content="{x:Static loc:Strings.Close}"
                        AutomationProperties.Name="{x:Static loc:Strings.Close_A11y}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
