<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NexusIsland.Modules.Media.Controls"
                    xmlns:loc="clr-namespace:NexusIsland.Modules.Media.Properties">
    <!--
      Plantillas del módulo Multimedia. La isla las busca por nombre:
        media.Compact  (148 x 32)   media.Peek  (248 x 40)   media.Expanded  (398 x 182)
      Colores y fuente vienen de la app (DynamicResource) para respetar un futuro tema.
    -->

    <FontFamily x:Key="MediaGlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Botón redondo con ícono, sin foco (la isla nunca roba el foco). -->
    <Style x:Key="MediaIconButton" TargetType="Button">
        <Setter Property="Focusable" Value="{DynamicResource IslandKeyboardMode}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="{StaticResource MediaGlyphFont}" />
        <Setter Property="Foreground" Value="{DynamicResource IslandForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse x:Name="FocusRing" Margin="-2" StrokeThickness="2"
                                 Stroke="{DynamicResource IslandAccent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indicador "sonando": tres barritas que siguen el volumen real (MediaViewModel.Bar*Height).
         Alto fijo de 15 px para que al moverse no cambie el tamaño de lo que las rodea. -->
    <DataTemplate x:Key="MediaPlayingBars">
        <StackPanel Orientation="Horizontal" Height="15" VerticalAlignment="Center">
            <Rectangle Width="3" Height="{Binding Bar1Height}" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource IslandAccent}" VerticalAlignment="Center" Margin="0,0,2,0" />
            <Rectangle Width="3" Height="{Binding Bar2Height}" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource IslandAccent}" VerticalAlignment="Center" Margin="0,0,2,0" />
            <Rectangle Width="3" Height="{Binding Bar3Height}" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource IslandAccent}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Carátula redondeada con un ícono de nota musical cuando la app no publica imagen. -->
    <Style x:Key="ArtworkBorder" TargetType="Border">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- ===================================================== CONTRAÍDA -->
    <DataTemplate x:Key="media.Compact">
        <Grid Margin="6,0,12,0">
            <Grid HorizontalAlignment="Left" Width="22" Height="22">
                <Border Style="{StaticResource ArtworkBorder}" CornerRadius="6">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource MediaGlyphFont}" FontSize="11"
                               Foreground="{DynamicResource IslandForegroundMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoArtwork, Converter={StaticResource BoolToVisibility}}" />
                </Border>
                <Border CornerRadius="6">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <ContentControl HorizontalAlignment="Right" Focusable="False"
                            Content="{Binding}" ContentTemplate="{StaticResource MediaPlayingBars}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="&#xE769;" FontFamily="{StaticResource MediaGlyphFont}" FontSize="11"
                       Foreground="{DynamicResource IslandForegroundMuted}"
                       Visibility="{Binding IsNotPlaying, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DataTemplate>

    <!-- ===================================================== VISTAZO -->
    <DataTemplate x:Key="media.Peek">
        <Grid Margin="7,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="28" Height="28" VerticalAlignment="Center">
                <Border Style="{StaticResource ArtworkBorder}" CornerRadius="7">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource MediaGlyphFont}" FontSize="13"
                               Foreground="{DynamicResource IslandForegroundMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoArtwork, Converter={StaticResource BoolToVisibility}}" />
                </Border>
                <Border CornerRadius="7">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandForeground}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" FontSize="11"
                           Foreground="{DynamicResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource MediaPlayingBars}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="&#xE769;" FontFamily="{StaticResource MediaGlyphFont}" FontSize="12"
                           Foreground="{DynamicResource IslandForegroundMuted}"
                           Visibility="{Binding IsNotPlaying, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ===================================================== EXPANDIDA -->
    <DataTemplate x:Key="media.Expanded">
        <Grid Margin="18,16,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Carátula + datos -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="64" Height="64">
                    <Border Style="{StaticResource ArtworkBorder}" CornerRadius="12">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource MediaGlyphFont}" FontSize="24"
                                   Foreground="{DynamicResource IslandForegroundMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoArtwork, Converter={StaticResource BoolToVisibility}}" />
                    </Border>
                    <Border CornerRadius="12">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandForeground}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource IslandAccent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding AppName}" FontSize="11"
                                   Foreground="{DynamicResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Progreso: 1:23 ───────●──── 3:45 -->
            <Grid Grid.Row="1" Margin="0,12,0,0"
                  Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" FontSize="10.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource IslandForegroundMuted}" />
                <controls:MediaProgressBar Grid.Column="1" Height="16" Margin="2,0"
                                           Progress="{Binding Progress}" CanSeek="{Binding CanSeek}"
                                           SeekCommand="{Binding SeekCommand}" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10.5" VerticalAlignment="Center"
                           TextAlignment="Right" Foreground="{DynamicResource IslandForegroundMuted}" />
            </Grid>

            <!-- Controles -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource MediaIconButton}" Content="&#xE892;"
                        Command="{Binding PreviousCommand}" AutomationProperties.Name="{x:Static loc:Strings.Media_Previous}" ToolTip="{x:Static loc:Strings.Media_Previous}" />
                <Button Style="{StaticResource MediaIconButton}" Margin="14,0" Width="44" Height="44" FontSize="20"
                        Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}"
                        AutomationProperties.Name="{Binding PlayPauseLabel}" ToolTip="{Binding PlayPauseLabel}" />
                <Button Style="{StaticResource MediaIconButton}" Content="&#xE893;"
                        Command="{Binding NextCommand}" AutomationProperties.Name="{x:Static loc:Strings.Media_Next}" ToolTip="{x:Static loc:Strings.Media_Next}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
