<Project Sdk="Microsoft.NET.Sdk">

  <!-- Motor de traducción local (Opus-MT en ONNX Runtime). Corre en un proceso aparte
       (NexusIsland.exe con el argumento "translator") para que su memoria (~260 MB) se libere al terminar. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusIsland.Core\NexusIsland.Core.csproj" />
  </ItemGroup>

</Project>
