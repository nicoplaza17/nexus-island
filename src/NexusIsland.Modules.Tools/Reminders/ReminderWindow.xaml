<Window x:Class="NexusIsland.Modules.Tools.Reminders.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Island — Recordatorios"
        Icon="pack://application:,,,/Assets/NexusIsland.ico"
        Width="440" Height="520" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="22,14,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nuevo recordatorio" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBox x:Name="ReminderText" Grid.Row="1" FontSize="14" MaxLength="200"
                 ToolTip="¿Qué hay que recordar?" AutomationProperties.Name="Texto del recordatorio" />

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="InMinutesRadio" GroupName="When" IsChecked="True" VerticalAlignment="Center"
                             Content="En" Margin="0,0,8,0" />
                <TextBox x:Name="MinutesInput" Width="64" Text="10" VerticalAlignment="Center"
                         AutomationProperties.Name="Minutos" />
                <TextBlock Text="minutos" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AtTimeRadio" GroupName="When" VerticalAlignment="Center"
                             Content="A las" Margin="0,0,8,0" />
                <TextBox x:Name="TimeInput" Width="80" VerticalAlignment="Center"
                         AutomationProperties.Name="Hora (HH:mm)" />
                <TextBlock Text="(HH:mm; si ya pasó, es mañana)" Opacity="0.6" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="AddButton" Content="Agregar" IsDefault="True" Padding="18,6" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Pendientes" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8" />

        <Grid Grid.Row="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PendingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" FontFamily="Consolas" Opacity="0.75"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Text}" />
                                <Button Grid.Column="2" Content="Borrar" Padding="10,2" Margin="8,0,0,0"
                                        Tag="{Binding Id}" Click="OnDeleteClick"
                                        AutomationProperties.Name="{Binding DeleteLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Text="No hay recordatorios pendientes." Opacity="0.6" />
        </Grid>
    </Grid>
</Window>
