<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramientas rápidas: temporizador, cronómetro, recordatorios y portapapeles.
       Cuatro módulos independientes (se activan/desactivan por separado) en un mismo proyecto. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Tema Fluent de WPF en la ventana de recordatorios (experimental en .NET 10). -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusIsland.Core\NexusIsland.Core.csproj" />
  </ItemGroup>

</Project>
