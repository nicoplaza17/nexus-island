<Window x:Class="NexusIsland.Modules.Security.SecurityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NexusIsland.Modules.Security.Properties"
        Title="{x:Static loc:Strings.Window_Title}"
        Width="620" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <!-- Los recursos van antes del contenido: WPF no admite usar un StaticResource declarado después. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="WinBoolToVisibility" />
    </Window.Resources>
    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="{Binding HeaderLine}" Opacity="0.7" Margin="0,2,0,0" />
        <TextBlock Grid.Row="2" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14" />

        <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.Window_Evidence}" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBox Grid.Row="4" Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static loc:Strings.Window_Evidence}" />

        <TextBlock Grid.Row="5" Text="{Binding ModelLabel}" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBox Grid.Row="6" x:Name="ExplanationBox" Text="{Binding Explanation, Mode=OneWay}" IsReadOnly="True" FontSize="13.5"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{Binding ModelLabel}" AutomationProperties.LiveSetting="Polite" />

        <TextBlock Grid.Row="7" Text="{Binding Stage}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85" />
        <Grid Grid.Row="8" Margin="0,10,0,0">
            <TextBlock Text="{x:Static loc:Strings.Window_Disclaimer}" TextWrapping="Wrap" Opacity="0.6" FontSize="11.5"
                       VerticalAlignment="Center" Margin="0,0,250,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:Strings.Explain}" Command="{Binding StartExplainCommand}" Padding="12,5" Margin="0,0,8,0"
                        Visibility="{Binding CanExplain, Converter={StaticResource WinBoolToVisibility}}" />
                <Button Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Padding="12,5" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:Strings.Close}" Click="OnClose" Padding="12,5" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
