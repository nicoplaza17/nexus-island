<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:NexusIsland.Modules.Security.Properties">
    <!--
      Seguridad. security.* = una alerta; security.panel.* = el panel con el estado y el historial.
      Tamaños: Compact 148x32 · Peek 248x40 · Expanded 398x182.
    -->

    <FontFamily x:Key="SecGlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="SecCriticalBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="SecWarningBrush" Color="#FFF5A524" />
    <BooleanToVisibilityConverter x:Key="SecBoolToVisibility" />

    <!-- Escudo de color según la gravedad -->
    <DataTemplate x:Key="SecShield">
        <Grid>
            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource SecGlyphFont}" Foreground="{StaticResource SecCriticalBrush}"
                       Visibility="{Binding IsCritical, Converter={StaticResource SecBoolToVisibility}}" />
            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource SecGlyphFont}" Foreground="{StaticResource SecWarningBrush}"
                       Visibility="{Binding IsWarning, Converter={StaticResource SecBoolToVisibility}}" />
            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource SecGlyphFont}" Foreground="{DynamicResource IslandForegroundMuted}"
                       Visibility="{Binding IsInfo, Converter={StaticResource SecBoolToVisibility}}" />
        </Grid>
    </DataTemplate>

    <!-- ===================================================== ALERTA -->
    <DataTemplate x:Key="security.Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SecShield}" Focusable="False" FontSize="12" Margin="0,1,8,0" />
            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" MaxWidth="104"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="security.Peek">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SecShield}" Focusable="False" FontSize="13"
                            Margin="0,1,10,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" MaxWidth="190" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="security.Expanded">
        <Grid Margin="22,14,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SecShield}" Focusable="False" FontSize="16" Margin="0,2,10,0" />
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" MaxWidth="320" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource IslandForeground}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding HeaderLine}" FontSize="11" Margin="0,3,0,0"
                       Foreground="{DynamicResource IslandForegroundMuted}" />
            <TextBlock Grid.Row="2" Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForeground}" />
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button Style="{DynamicResource IslandPillButton}" Command="{Binding ExplainCommand}" Margin="0,0,6,0"
                        AutomationProperties.Name="{x:Static loc:Strings.Explain}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource SecGlyphFont}" Margin="0,1,6,0" />
                        <TextBlock Text="{x:Static loc:Strings.Explain}" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource IslandPillButton}" Command="{Binding DismissCommand}" Margin="0,0,6,0"
                        Content="{x:Static loc:Strings.GotIt}" AutomationProperties.Name="{x:Static loc:Strings.GotItA11y}" />
                <Button Style="{DynamicResource IslandPillButton}" Command="{Binding HistoryCommand}"
                        Content="{x:Static loc:Strings.History}" AutomationProperties.Name="{x:Static loc:Strings.History}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===================================================== PANEL -->
    <DataTemplate x:Key="security.panel.Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource SecGlyphFont}" FontSize="12" Margin="0,1,8,0"
                       Foreground="{DynamicResource IslandAccent}" />
            <TextBlock Text="{x:Static loc:Strings.Module_Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="security.panel.Peek">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource SecGlyphFont}" FontSize="13" Margin="0,1,10,0"
                       Foreground="{DynamicResource IslandAccent}" />
            <TextBlock Text="{x:Static loc:Strings.Module_Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="security.panel.Expanded">
        <Grid Margin="18,12,18,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource SecGlyphFont}" FontSize="13" Margin="0,2,8,0"
                           Foreground="{DynamicResource IslandAccent}" />
                <TextBlock Text="{x:Static loc:Strings.Module_Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource IslandForeground}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,4"
                       Foreground="{DynamicResource IslandForegroundMuted}" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Focusable="False"
                          Visibility="{Binding HasItems, Converter={StaticResource SecBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource IslandPillButton}" Background="Transparent" Padding="6,3" Margin="0,1"
                                    HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}"
                                    AutomationProperties.Name="{Binding OpenLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Content="{Binding Alert}" ContentTemplate="{StaticResource SecShield}" Focusable="False"
                                                    FontSize="11" Margin="0,1,8,0" />
                                    <TextBlock Text="{Binding Alert.TimeText}" FontSize="11.5" Margin="0,0,8,0"
                                               Foreground="{DynamicResource IslandForegroundMuted}" />
                                    <TextBlock Text="{Binding Alert.Title}" FontSize="11.5" MaxWidth="270" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource IslandForeground}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.Empty}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource IslandForegroundMuted}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource SecBoolToVisibility}}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
