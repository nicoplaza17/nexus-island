<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:NexusIsland.Modules.Monitor.Properties">
    <!--
      monitor.*        → panel "Sistema" (MonitorPanelViewModel)
      monitor.alert.*  → alertas (MonitorAlertViewModel)
      Expanded 398x182: abajo a la derecha está el botón de herramientas de la isla.
    -->
    <FontFamily x:Key="MonGlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="MonAlertBrush" Color="#FFF5A524" />
    <SolidColorBrush x:Key="MonCriticalBrush" Color="#FFF87171" />
    <SolidColorBrush x:Key="MonTileBrush" Color="#14FFFFFF" />
    <BooleanToVisibilityConverter x:Key="MonBoolToVisibility" />

    <ControlTemplate x:Key="MonBar" TargetType="ProgressBar">
        <Grid>
            <Border CornerRadius="2" Background="#33FFFFFF" />
            <Border x:Name="PART_Track" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                    Background="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="MonTileLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource IslandForegroundMuted}" />
    </Style>
    <Style x:Key="MonTileValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Foreground" Value="{DynamicResource IslandForeground}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============================================================ PANEL -->
    <DataTemplate x:Key="monitor.Compact">
        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource MonGlyphFont}" FontSize="12"
                   Foreground="{DynamicResource IslandForegroundMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="monitor.Peek">
        <Grid Margin="18,0">
            <TextBlock Text="{x:Static loc:Strings.Panel_Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource IslandForegroundMuted}" />
            <TextBlock Text="{Binding CpuText, StringFormat=CPU {0}}" FontSize="12" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource IslandForeground}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="monitor.Expanded">
        <Grid Margin="16,12,16,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Static loc:Strings.Panel_Title}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,6"
                       Foreground="{DynamicResource IslandForegroundMuted}" />
            <TextBlock Grid.Column="1" Text="{Binding TemperatureText}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,4,6"
                       Foreground="{DynamicResource IslandForegroundMuted}"
                       ToolTip="{x:Static loc:Strings.Temp_Tip}"
                       Visibility="{Binding HasTemperature, Converter={StaticResource MonBoolToVisibility}}" />

            <!-- CPU -->
            <Border Grid.Row="1" Background="{StaticResource MonTileBrush}" CornerRadius="10" Padding="10,4" Margin="0,0,3,3">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.Tile_Cpu}" Style="{StaticResource MonTileLabel}" />
                    <TextBlock Text="{Binding CpuText}" Style="{StaticResource MonTileValue}" />
                    <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding CpuValue, Mode=OneWay}"
                                 Template="{StaticResource MonBar}" Foreground="{DynamicResource IslandAccent}" />
                </StackPanel>
            </Border>
            <!-- RAM -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource MonTileBrush}" CornerRadius="10" Padding="10,4" Margin="3,0,0,3">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.Tile_Memory}" Style="{StaticResource MonTileLabel}" />
                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MonTileValue}" />
                    <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding MemoryValue, Mode=OneWay}"
                                 Template="{StaticResource MonBar}" Foreground="{DynamicResource IslandAccent}" />
                </StackPanel>
            </Border>
            <!-- RED -->
            <Border Grid.Row="2" Background="{StaticResource MonTileBrush}" CornerRadius="10" Padding="10,4" Margin="0,3,3,0">
                <StackPanel>
                    <TextBlock Text="{Binding NetworkText}" Style="{StaticResource MonTileLabel}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding DownloadText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,12,0"
                                   Foreground="{DynamicResource IslandForeground}" />
                        <TextBlock Text="{Binding UploadText}" FontSize="12.5" Foreground="{DynamicResource IslandForegroundMuted}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- BATERÍA -->
            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource MonTileBrush}" CornerRadius="10" Padding="10,4" Margin="3,3,0,0"
                    Visibility="{Binding HasBattery, Converter={StaticResource MonBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.Tile_Battery}" Style="{StaticResource MonTileLabel}" />
                    <TextBlock Text="{Binding BatteryText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0"
                               Foreground="{DynamicResource IslandForeground}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ ALERTAS -->
    <DataTemplate x:Key="monitor.alert.Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
            <Grid Margin="0,1,8,0">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonGlyphFont}" FontSize="12"
                           Foreground="{StaticResource MonCriticalBrush}"
                           Visibility="{Binding IsCritical, Converter={StaticResource MonBoolToVisibility}}" />
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonGlyphFont}" FontSize="12"
                           Foreground="{StaticResource MonAlertBrush}"
                           Visibility="{Binding IsNotCritical, Converter={StaticResource MonBoolToVisibility}}" />
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" MaxWidth="104"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="monitor.alert.Peek">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <Grid Margin="0,1,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonGlyphFont}" FontSize="13"
                           Foreground="{StaticResource MonCriticalBrush}"
                           Visibility="{Binding IsCritical, Converter={StaticResource MonBoolToVisibility}}" />
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonGlyphFont}" FontSize="13"
                           Foreground="{StaticResource MonAlertBrush}"
                           Visibility="{Binding IsNotCritical, Converter={StaticResource MonBoolToVisibility}}" />
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" MaxWidth="190"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Foreground="{DynamicResource IslandForeground}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="monitor.alert.Expanded">
        <Grid Margin="24,16,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Grid Margin="0,2,10,0">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonGlyphFont}" FontSize="16"
                               Foreground="{StaticResource MonCriticalBrush}"
                               Visibility="{Binding IsCritical, Converter={StaticResource MonBoolToVisibility}}" />
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonGlyphFont}" FontSize="16"
                               Foreground="{StaticResource MonAlertBrush}"
                               Visibility="{Binding IsNotCritical, Converter={StaticResource MonBoolToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource IslandForeground}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="52"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandForegroundMuted}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <Button Style="{DynamicResource IslandPillButton}" Command="{Binding DismissCommand}" Content="{x:Static loc:Strings.Alert_GotIt}"
                        AutomationProperties.Name="{x:Static loc:Strings.Alert_CloseA11y}" Margin="0,0,6,0" />
                <Button Style="{DynamicResource IslandPillButton}" Command="{Binding OpenPanelCommand}" Content="{x:Static loc:Strings.Alert_ViewSystem}"
                        AutomationProperties.Name="{x:Static loc:Strings.Alert_ViewSystemA11y}"
                        Visibility="{Binding CanOpenPanel, Converter={StaticResource MonBoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
